# Server Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SuperSecretPassword123!
JWT_SECRET=your-very-long-random-jwt-secret-key-change-this-in-production-abc123xyz

# CAPTCHA Solver API (choose one)
CAPTCHA_PROVIDER=capsolver
CAPSOLVER_API_KEY=CAP-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWOCAPTCHA_API_KEY=

# Suno AI Configuration
SUNO_BASE_URL=https://suno.com
SUNO_API_BASE=https://studio-api.suno.ai

# Puppeteer Configuration
PUPPETEER_HEADLESS=true
PUPPETEER_TIMEOUT=60000
BROWSER_POOL_SIZE=3

# Session & Health Check
SESSION_CHECK_INTERVAL=300000
PROXY_CHECK_INTERVAL=120000
CREDIT_CHECK_INTERVAL=600000

# Queue Configuration
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT=300000

# Railway specific
RAILWAY_STATIC_URL=